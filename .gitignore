__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.DS_Store

# CRITICAL: real scans and project data never enter Git or agent context.
# data/, scans/, real_data/, and TIFF sources stay excluded.
data/
scans/
real_data/
*.tiff
*.tif

# Local model weights and generated exports stay on the machine.
models/
exports/
*.onnx
*.pt
*.gguf

# Agent debug logs are not tracked.
.cursor/**/*.log

# Verification transcripts stay on the machine. Cleanup does not delete them.
.cursor/skills/verify-prw/artifacts/
